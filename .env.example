# Gemini Developer API (workshop key from AI Studio). Server-side only, never shipped to the browser.
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_VISION_MODEL=gemini-3.8-flash
# Optional per-role overrides (default: GEMINI_VISION_MODEL), e.g. GEMINI_QUERY_MODEL=gemini-4-argon
GEMINI_PERCEPTION_MODEL=
GEMINI_QUERY_MODEL=

# Database. Local dev/tests: a SQLite file. Deployed (Vercel): Turso libSQL URL + token.
DATABASE_URL=sqlite:///./data/labmate.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Vision: primary provider (gemini) + optional specialist sub-model chained after it: none | local | modal
VISION_PROVIDER=gemini
SPECIALIST_PROVIDER=none
# SPECIALIST_MODULE=modal_app.specialist.model

# Modal (specialist inference). Token values are in ~/.modal.toml after `modal token new`.
MODAL_ENABLED=false
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
# MODAL_GPU=T4    # only if the real model needs a GPU (costs credits)

# Telemetry (content-free spans in the app DB) + local Langfuse export (scripts/langfuse_sync.py)
TELEMETRY_ENABLED=true
LANGFUSE_HOST=http://127.0.0.1:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_ENVIRONMENT=dev

# Person 3 specialist checkpoint (optional)
KLARITY_MODEL_PATH=models/klarity-model.pt
